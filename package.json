{
  "name": "OpenDaw",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test src/ desktop/scan.test.cjs",
    "app": "npm run build && npm --prefix desktop start",
    "app:test": "npm run build && npm --prefix desktop run selftest",
    "app:exe": "npm run build && node desktop/build-app.cjs",
    "app:installer": "npm run build && npm --prefix desktop run build:installer",
    "app:portable": "npm run build && npm --prefix desktop run build:portable",
    "deploy": "vite build && gh-pages -d dist"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "neural-amp-modeler-wasm": "^3.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
