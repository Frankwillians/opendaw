{
  "name": "opendaw-desktop",
  "productName": "OpenDAW",
  "version": "1.1.5",
  "private": true,
  "description": "OpenDAW - versao executavel para PC, com hospedagem nativa de plugins VST.",
  "main": "main.cjs",
  "type": "commonjs",
  "author": "OpenDAW",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "spike-rt": "electron spike-rt-port.cjs",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.opendaw.desktop",
    "productName": "OpenDAW",
    "asar": false,
    "copyright": "Copyright (c) 2025 OpenDAW",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "*.cjs",
      "vendor/**/*",
      "icon.png",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "OpenDAW-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenDAW",
      "uninstallDisplayName": "OpenDAW",
      "license": "LICENSE",
      "artifactName": "OpenDAW-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenDAW-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
