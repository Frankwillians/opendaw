type Tab = 'arrangement' | 'sequencer' | 'piano'
type PluginState = PluginInfo & { enabled: boolean }
type DrumStep = DrumStepData

interface TrackState {
  id: string
  number: number
  name: string
  color: string
  volume: number
  pan: number
  isArmed: boolean
  isMuted: boolean
  isSoloed: boolean
  hasFx: boolean
  drive: number
  cabinet: number
  inputDeviceId: string
  inputMonitor: boolean
  plugins: PluginState[]
  clipStart: number
  clipDuration: number
}

function emptyDrums(): DrumStep[] {
  return Array.from({ length: 16 }, () => ({ kick: 0, snare: 0, hihat: 0 }))
}

function emptyGrid(): boolean[][] {
  return Array.from({ length: 25 }, () => Array.from({ length: 16 }, () => false))
}

function emptyMutes(): Record<DrumInstrument, boolean> {
  return { kick: false, snare: false, hihat: false }
}

function clampNumber(value: unknown, min: number, max: number, fallback: number): number {
  if (typeof value !== 'number' || !Number.isFinite(value)) return fallback
  return Math.min(max, Math.max(min, value))
}

function sanitizeDrumValue(value: unknown): number {
  if (value === true) return 1
  if (typeof value === 'number' && Number.isFinite(value)) {
    return Math.max(0, Math.min(2, Math.round(value)))
  }
  return 0
}

function sanitizeDrums(value: unknown): DrumStep[] {
  if (!Array.isArray(value) || value.length !== 16) return emptyDrums()
  return value.map((step) => {
    const entry = (step ?? {}) as Partial<Record<DrumInstrument, unknown>>
    return {
      kick: sanitizeDrumValue(entry.kick),
      snare: sanitizeDrumValue(entry.snare),
      hihat: sanitizeDrumValue(entry.hihat),
    }
  })
}

function migrateLegacySeq(seq: (number | null)[] | undefined): boolean[][] {
  const grid = emptyGrid()
  if (!Array.isArray(seq)) return grid
  seq.forEach((freq, step) => {
    if (typeof freq !== 'number' || step >= 16) return
    let bestRow = -1
    let bestDistance = Number.POSITIVE_INFINITY
    const DISPLAY_NOTES = [
      { freq: 130.81, name: 'C3', isBlack: false },
      { freq: 146.83, name: 'D3', isBlack: false },
      { freq: 164.81, name: 'E3', isBlack: false },
      { freq: 185, name: 'F3', isBlack: true },
      { freq: 196, name: 'G3', isBlack: false },
      { freq: 207.65, name: 'A3', isBlack: false },
      { freq: 233.08, name: 'B3', isBlack: false },
      { freq: 246.94, name: 'C4', isBlack: false },
    ]
    DISPLAY_NOTES.forEach((note, row) => {
      const distance = Math.abs(note.freq - freq)
      if (distance < bestDistance) {
        bestDistance = distance
        bestRow = row
      }
    })
    if (bestRow >= 0) grid[bestRow][step] = true
  })
  return grid
}

function sanitizeGrid(value: unknown, legacy?: (number | null)[]): boolean[][] {
  if (!Array.isArray(value) || value.length !== 25) {
    return Array.from({ length: 25 }, () => Array.from({ length: 16 }, () => false))
  }
  const grid = Array.from({ length: 25 }, () => Array.from({ length: 16 }, () => false))
  value.forEach((freq, step) => {
    if (typeof freq !== 'number' || step >= 16) return
    let bestRow = -1
    let bestDistance = Number.POSITIVE_INFINITY
    const DISPLAY_NOTES = [
      { freq: 130.81, name: 'C3', isBlack: false },
      { freq: 146.83, name: 'D3', isBlack: false },
      { freq: 164.81, name: 'E3', isBlack: false },
      { freq: 185, name: 'F3', isBlack: true },
      { freq: 196, name: 'G3', isBlack: false },
      { freq: 207.65, name: 'A3', isBlack: false },
      { freq: 233.08, name: 'B3', isBlack: false },
      { freq: 246.94, name: 'C4', isBlack: false },
    ]
    DISPLAY_NOTES.forEach((note, row) => {
      const distance = Math.abs(note.freq - freq)
      if (distance < bestDistance) {
        bestDistance = distance
        bestRow = row
      }
    })
    if (bestRow >= 0) grid[bestRow][step] = true
  })
  return grid
}

function sanitizeProject(data: any): any {
  const tracks = Array.isArray(data.tracks) ? data.tracks.map((t: any) => ({
    id: t.id ?? `track-${Math.random().toString(36).slice(2, 9)}`,
    number: t.number ?? 1,
    name: t.name ?? `Track ${t.number}`,
    color: t.color ?? '#1a1a1a',
    volume: clampNumber(t.volume, 0, 1, 1),
    pan: clampNumber(t.pan, -1, 1, 0),
    isArmed: Boolean(t.isArmed),
    isMuted: Boolean(t.isMuted),
    isSoloed: Boolean(t.isSoloed),
    hasFx: Boolean(t.hasFx),
    drive: clampNumber(t.drive, 1, 100, 35),
    cabinet: clampNumber(t.cabinet, 1000, 8000, 4500),
    inputDeviceId: t.inputDeviceId ?? '',
    inputMonitor: Boolean(t.inputMonitor),
    plugins: t.plugins ?? [],
    clipStart: clampNumber(t.clipStart, 0, 100000, 0),
    clipDuration: clampNumber(t.clipDuration, 0, 100000, 0),
  })) : []
  return {
    version: 2,
    bpm: clampNumber(data.bpm, 40, 280, 120),
    masterVolume: clampNumber(data.masterVolume, 0, 1.5, 0.9),
    masterMuted: Boolean(data.masterMuted),
    metronome: false,
    loop: data.loop !== false,
    arrangementBars: clampNumber(data.arrangementBars, 1, 128, 16),
    drumSeq: sanitizeDrums(data.drumSeq),
    drumMute: {
      kick: Boolean(data.drumMute?.kick),
      snare: Boolean(data.drumMute?.snare),
      hihat: Boolean(data.drumMute?.hihat),
    },
    synthGrid: sanitizeGrid(data.synthGrid, data.drumSeq),
    tracks,
  }
}

function loadStored(): any {
  try {
    const raw = window.localStorage.getItem('web-daw-project-v1')
    if (!raw) return null
    const parsed = JSON.parse(raw)
    if (!parsed || !Array.isArray(parsed.tracks) || parsed.tracks.length === 0) return null
    return sanitizeProject(parsed)
  } catch {
    return null
  }
}

function computePeaks(buffer: any, count = 260): number[] {
  const data = buffer.getChannelData(0)
  const block = Math.max(1, Math.floor(data.length / count))
  const peaks: number[] = []
  for (let i = 0; i < count; i += 1) {
    let min = 1
    let max = -1
    for (let j = 0; j < block; j += 1) {
      const value = data[i * block + j] ?? 0
      if (value < min) min = value
      if (value > max) max = value
    }
    peaks.push(Math.max(Math.abs(min), Math.abs(max)))
  }
  return peaks
}

function downloadBlob(blob: any, filename: any): void {
  const url = URL.createObjectURL(blob)
  const anchor = document.createElement('a')
  anchor.href = url
  anchor.download = filename
  document.body.appendChild(anchor)
  anchor.click()
  anchor.remove()
  window.setTimeout(() => URL.revokeObjectURL(url), 1500)
}

function slugify(name: string): string {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
}

